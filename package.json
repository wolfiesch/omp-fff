{
  "name": "omp-fff",
  "version": "0.2.0",
  "description": "Lazy, repository-scoped FFF search for Oh My Pi and Pi",
  "keywords": [
    "fff",
    "file-search",
    "mcp",
    "oh-my-pi",
    "omp-plugin",
    "pi",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wolfiesch/omp-fff.git"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
